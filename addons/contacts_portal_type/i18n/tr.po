#. module: contacts_portal_type
msgid "Contacts Portal Contact Type"
msgstr "İletişim Portal İletişim Türü"

#. module: contacts_portal_type
msgid "Portal contact type on partners"
msgstr "İş ortaklarında portal iletişim türü"

#. module: contacts_portal_type
msgid "Sales/CRM"
msgstr "Satış/CRM"

#. module: contacts_portal_type
msgid "Hostess"
msgstr "Hostes"

#. module: contacts_portal_type
msgid "Portal hostess who started this tour from the website."
msgstr "Bu turu web sitesinden başlatan portal hostesidir."

#. module: contacts_portal_type
msgid "User Dashboard"
msgstr "Kullanıcı Paneli"

#. module: contacts_portal_type
msgid "This action is only available for portal users whose contact is set to Hostess."
msgstr "Bu işlem yalnızca iletişim türü Hostes olarak ayarlanmış portal kullanıcıları için geçerlidir."

#. module: contacts_portal_type
msgid "Please sign in to continue."
msgstr "Devam etmek için lütfen giriş yapın."

#. module: contacts_portal_type
msgid "You already have an active tour. Finish it before starting a new one."
msgstr "Zaten aktif bir turunuz var. Yeni tur başlatmadan önce mevcut turu bitirin."

#. module: contacts_portal_type
msgid "Invalid route or shuttle."
msgstr "Geçersiz güzergâh veya servis."

#. module: contacts_portal_type
msgid "The selected shuttle does not match the route."
msgstr "Seçilen servis bu güzergâha ait değil."

#. module: contacts_portal_type
msgid "Invalid tour or coordinates."
msgstr "Geçersiz tur veya koordinatlar."

#. module: contacts_portal_type
msgid "Tour not found or already finished."
msgstr "Tur bulunamadı veya zaten tamamlandı."

#. module: contacts_portal_type
msgid "Invalid tour."
msgstr "Geçersiz tur."

#. module: contacts_portal_type
msgid "Tour not found."
msgstr "Tur bulunamadı."

#. module: contacts_portal_type
msgid "Geolocation is not supported by this browser."
msgstr "Bu tarayıcı konum hizmetini desteklemiyor."

#. module: contacts_portal_type
msgid "Invalid response from server. Try refreshing the page."
msgstr "Sunucudan geçersiz yanıt. Sayfayı yenilemeyi deneyin."

#. module: contacts_portal_type
msgid "Request failed"
msgstr "İstek başarısız"

#. module: contacts_portal_type
msgid "Request failed (%s). If the problem continues, sign out and sign in again."
msgstr "İstek başarısız (%s). Sorun sürerse oturumu kapatıp tekrar açın."

#. module: contacts_portal_type
msgid "Unexpected response from server (not JSON). Try refreshing the page."
msgstr "Sunucudan beklenmeyen yanıt (JSON değil). Sayfayı yenileyin."

#. module: contacts_portal_type
msgid "Please select a route and a shuttle."
msgstr "Lütfen bir güzergâh ve bir servis seçin."

#. module: contacts_portal_type
msgid "Getting location…"
msgstr "Konum alınıyor…"

#. module: contacts_portal_type
msgid "No location; using a random point on the Anatolian side of Istanbul."
msgstr "Konum yok; İstanbul Anadolu yakasında rastgele bir nokta kullanılıyor."

#. module: contacts_portal_type
msgid "Tour %s started."
msgstr "Tur %s başlatıldı."

#. module: contacts_portal_type
msgid "Could not start tour. Try again."
msgstr "Tur başlatılamadı. Tekrar deneyin."

#. module: contacts_portal_type
msgid "Tour point added."
msgstr "Tur noktası eklendi."

#. module: contacts_portal_type
msgid "Could not add point."
msgstr "Nokta eklenemedi."

#. module: contacts_portal_type
msgid "Tour finished. Destination recorded."
msgstr "Tur bitti. Varış kaydedildi."

#. module: contacts_portal_type
msgid "Could not finish tour."
msgstr "Tur bitirilemedi."

#. module: contacts_portal_type
msgid "Notes saved."
msgstr "Notlar kaydedildi."

#. module: contacts_portal_type
msgid "Could not save notes."
msgstr "Notlar kaydedilemedi."

#. module: contacts_portal_type
msgid "Shuttle tour"
msgstr "Servis turu"

#. module: contacts_portal_type
msgid "Active tour:"
msgstr "Aktif tur:"

#. module: contacts_portal_type
msgid "No active tour. Select a route and shuttle, then start."
msgstr "Aktif tur yok. Güzergâh ve servis seçin, ardından başlatın."

#. module: contacts_portal_type
msgid "Route"
msgstr "Güzergâh"

#. module: contacts_portal_type
msgid "Shuttle"
msgstr "Servis"

#. module: contacts_portal_type
msgid "Select route..."
msgstr "Güzergâh seçin..."

#. module: contacts_portal_type
msgid "Select shuttle..."
msgstr "Servis seçin..."

#. module: contacts_portal_type
msgid "Start Tour"
msgstr "Turu Başlat"

#. module: contacts_portal_type
msgid "Add Tour Point"
msgstr "Tur Noktası Ekle"

#. module: contacts_portal_type
msgid "Finish Tour"
msgstr "Turu Bitir"

#. module: contacts_portal_type
msgid "Tour notes"
msgstr "Tur notları"

#. module: contacts_portal_type
msgid "Save notes"
msgstr "Notları kaydet"

#. module: contacts_portal_type
msgid "Hostess portal"
msgstr "Hostes portalı"

#. module: contacts_portal_type
msgid "Welcome %s"
msgstr "Hoş geldiniz %s"

#. module: contacts_portal_type
msgid "Parents"
msgstr "Veliler"
