</svg>
                                </span>
                                <field name="is_handicapped" widget="boolean_toggle" string=""/>
                            </span>
                            <span class="d-inline-flex align-items-center gap-1" title="İşitme engelli">
                                <span class="text-muted lh-1" aria-label="İşitme engelli">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8.5 1.5a4.5 4.5 0 0 1 4.5 4.5c0 1.88-1.1 3.22-2.1 4.27-.2.21-.4.41-.58.6-.77.83-1.07 1.32-1.07 2.13a2.25 2.25 0 0 1-4.5 0h1.2a1.05 1.05 0 0 0 2.1 0c0-1.29.56-2.14 1.52-3.18.18-.2.37-.4.57-.6.96-1 1.76-2.03 1.76-3.82a3.3 3.3 0 0 0-6.6 0h-1.2A4.5 4.5 0 0 1 8.5 1.5z"/>
                                        <path d="M2.2 2.2a.6.6 0 0 1 .85 0l10.75 10.75a.6.6 0 0 1-.85.85L2.2 3.05a.6.6 0 0 1 0-.85z"/>
                                    </svg>
                                </span>
                                <field name="is_deaf" widget="boolean_toggle" string=""/>
                            </span>
                            <span class="d-inline-flex align-items-center gap-1" title="Görme engelli">
                                <span class="text-muted lh-1" aria-label="Görme engelli">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M16 8s-3 5-8 5-8-5-8-5 3-5 8-5 8 5 8 5z"/>
                                        <path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" fill="#fff"/>
                                        <path d="M2.2 2.2a.6.6 0 0 1 .85 0l10.75 10.75a.6.6 0 0 1-.85.85L2.2 3.05a.6.6 0 0 1 0-.85z"/>
                                    </svg>
                                </span>
                                <field name="is_blind" widget="boolean_toggle" string=""/>
                            </span>
                            <span class="d-inline-flex align-items-center gap-1" title="Alerjik">
                                <span class="text-muted lh-1" aria-label="Alerjik">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.964 0L.165 13.233c-.457.778.091 1.767.982 1.767h13.706c.89 0 1.438-.99.982-1.767L8.982 1.566z"/>
