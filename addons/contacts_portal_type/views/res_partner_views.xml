                                </span>
                                <field name="is_allergic" widget="boolean_toggle" string=""/>
                            </span>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- Full width map below the 2-column address block -->
            <xpath expr="//group[.//div[contains(@class,'o_address_format')]]" position="after">
                <div class="mt-2 w-100">
                    <widget name="partner_location_map"/>
                </div>
            </xpath>

            <!-- Hide default sheet duplicates; keep fields inside notebook subviews (e.g. Addresses) untouched. Duplicates live on the Information tab below. -->
            <xpath expr="//sheet//field[@name='parent_id'][not(ancestor::notebook)]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">portal_contact_type != 'parent'</attribute>
            </xpath>
            <xpath expr="//page[@name='accounting']" position="attributes">
                <attribute name="invisible">portal_contact_type != 'parent'</attribute>
            </xpath>
            <xpath expr="//page[@name='accounting_disabled']" position="attributes">
                <attribute name="invisible">portal_contact_type != 'parent'</attribute>
            </xpath>
            <xpath expr="//sheet//field[@name='function'][not(ancestor::notebook)]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//sheet//field[@name='vat'][not(ancestor::notebook)]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//sheet//field[@name='website'][not(ancestor::notebook)]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//sheet//field[@name='lang'][not(ancestor::notebook)]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//sheet//field[@name='category_id'][not(ancestor::notebook)]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <!-- First notebook under the sheet (main partner tabs); avoids targeting nested notebooks accidentally. -->
            <xpath expr="(//sheet//notebook)[1]" position="inside">
                <page string="Information" name="contact_information">
                    <group>
                        <group>
                            <field name="parent_id"
                                widget="res_partner_many2one"
                                placeholder="Company Name..."
                                string="Company"
                                domain="[('is_company', '=', True)]"
                                context="{'default_is_company': True, 'default_user_id': user_id, 'show_address': False}"/>
                            <field name="function" placeholder="e.g. Sales Director"/>
                            <field name="vat"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group>
                            <field name="lang" invisible="active_lang_count &lt;= 1"/>
                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                </page>
                <page string="Dependants" name="dependants" groups="base.group_user" invisible="portal_contact_type != 'parent'">
                    <field name="dependants_ids" mode="list,form" nolabel="1" context="{'default_parent_partner_id': id}">
                        <list>
                            <field name="avatar_128" widget="image" options="{'size': [24,24], 'img_class': 'o_avatar rounded'}"/>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <field name="image_1920" widget="contact_image" options="{'preview_image': 'avatar_128', 'size': [130,130], 'img_class': 'rounded border'}"/>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
                <page string="Shift Hours" name="shift_hours">
                    <group>
                        <field name="shift_hours_ids"
                               mode="list,form"
                               nolabel="1"
                               invisible="contact_type not in ('school', 'factory')">
                            <list>
                                <field name="shift_type"/>
                                <field name="start_hour" widget="float_time"/>
                                <field name="end_hour" widget="float_time"/>
                                <field name="monday"/>
                                <field name="tuesday"/>
                                <field name="wednesday"/>
                                <field name="thursday"/>
                                <field name="friday"/>
                                <field name="saturday"/>
                                <field name="sunday"/>
                            </list>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="shift_type"/>
                                        <field name="start_hour" widget="float_time"/>
                                        <field name="end_hour" widget="float_time"/>
                                        <group>
                                            <field name="monday"/>
                                            <field name="tuesday"/>
                                            <field name="wednesday"/>
                                            <field name="thursday"/>
                                            <field name="friday"/>
                                            <field name="saturday"/>
                                            <field name="sunday"/>
                                        </group>
                                    </group>
                                </sheet>
                            </form>
                        </field>

                        <field name="shift_hours_display_ids"
                               mode="list"
                               nolabel="1"
                               invisible="contact_type in ('school', 'factory')">
                            <list>
                                <field name="shift_type"/>
                                <field name="start_hour" widget="float_time"/>
                                <field name="end_hour" widget="float_time"/>
                                <field name="monday"/>
                                <field name="tuesday"/>
                                <field name="wednesday"/>
                                <field name="thursday"/>
                                <field name="friday"/>
                                <field name="saturday"/>
                                <field name="sunday"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Filtered contact lists (Contacts top menu bar) -->
    <record id="action_contacts_students" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="domain">[('contact_type', '=', 'person'), ('portal_contact_type', '=', 'student')]</field>
        <field name="context">{'default_contact_type': 'person', 'default_portal_contact_type': 'student'}</field>
    </record>

    <record id="action_contacts_parents" model="ir.actions.act_window">
        <field name="name">Parents</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="domain">[('contact_type', '=', 'person'), ('portal_contact_type', '=', 'parent')]</field>
        <field name="context">{'default_contact_type': 'person', 'default_portal_contact_type': 'parent'}</field>
    </record>

    <record id="action_contacts_employees" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="domain">[('contact_type', '=', 'person'), ('portal_contact_type', 'in', ['driver', 'hostess'])]</field>
        <field name="context">{'default_contact_type': 'person'}</field>
    </record>

    <record id="action_contacts_schools" model="ir.actions.act_window">
        <field name="name">Schools</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="domain">[('contact_type', '=', 'school')]</field>
        <field name="context">{'default_contact_type': 'school'}</field>
    </record>

    <record id="action_contacts_factories" model="ir.actions.act_window">
        <field name="name">Factories</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="domain">[('contact_type', '=', 'factory')]</field>
        <field name="context">{'default_contact_type': 'factory'}</field>
    </record>

    <menuitem id="menu_contacts_students"
              name="Students"
              parent="contacts.menu_contacts"
              action="action_contacts_students"
              sequence="3"/>

    <menuitem id="menu_contacts_parents"
              name="Parents"
              parent="contacts.menu_contacts"
              action="action_contacts_parents"
              sequence="4"/>

    <menuitem id="menu_contacts_schools"
              name="Schools"
              parent="contacts.menu_contacts"
              action="action_contacts_schools"
              sequence="5"/>

    <menuitem id="menu_contacts_factories"
              name="Factories"
              parent="contacts.menu_contacts"
              action="action_contacts_factories"
              sequence="6"/>

    <menuitem id="menu_contacts_employees"
              name="Employees"
              parent="contacts.menu_contacts"
              action="action_contacts_employees"
              sequence="7"/>
</odoo>
