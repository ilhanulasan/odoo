<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_portal_contact_type" model="ir.ui.view">
        <field name="name">res.partner.form.portal.contact.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class,'flex-column') and contains(@class,'flex-grow-1')]/field[@name='company_type']" position="replace">
                <field name="contact_type" widget="radio" options="{'horizontal': true}"/>
            </xpath>
            <xpath expr="//div[contains(@class,'flex-column') and contains(@class,'flex-grow-1')]/h1" position="after">
                <field name="portal_contact_type"
                       widget="radio"
                       options="{'horizontal': true}"
                       string="Portal Contact Type"
                       invisible="contact_type != 'person'"/>
            </xpath>

            <xpath expr="//sheet//span[@name='address_name']/following-sibling::div[contains(@class,'o_address_format')][1]" position="after">
                <!-- Route selection (visible to students and factory employees) -->
                <span class="o_form_label o_td_label mt-2" invisible="portal_contact_type not in ('student','factory_employee')">
                    <label for="route_id" class="fw-bold"/>
                </span>
                <div class="o_address_format d-flex align-items-center gap-2 mt-1" invisible="portal_contact_type not in ('student','factory_employee')">
                    <field name="route_id"
                           widget="many2one"
                           class="flex-grow-1"
                           options="{'no_create': False}"
                           context="{'default_route_id': False}"/>
                    <field name="route_shuttle_picture"
                           widget="image"
                           class="rounded"
                           options="{'size': [64, 64], 'img_class': 'rounded border object-fit-cover'}"
                           nolabel="1"
                           invisible="not route_id"/>
                </div>
                <span class="o_form_label o_td_label mt-2" invisible="contact_type != 'person' or portal_contact_type != 'student'">
                    <label for="parent_partner_id" class="fw-bold"/>
                </span>
                <div class="o_address_format d-flex align-items-center gap-2 mt-1" invisible="contact_type != 'person' or portal_contact_type != 'student'">
                    <field name="parent_partner_id"
                           widget="many2one"
                           class="flex-grow-1"
                           domain="[('portal_contact_type','=', 'parent'), ('contact_type', '=', 'person')]"
                           options="{'no_create': False}"/>
                    <field name="parent_avatar_128"
                           widget="image"
                           class="rounded"
                           options="{'size': [64, 64], 'img_class': 'rounded border object-fit-cover'}"
                           nolabel="1"/>
                </div>
                <span class="o_form_label o_td_label mt-2" invisible="portal_contact_type not in ('student','factory_employee') or not route_id">
                    <label for="annual_fee" class="fw-bold"/>
                </span>
                <div class="o_address_format d-flex align-items-center gap-2 mt-1" invisible="portal_contact_type not in ('student','factory_employee') or not route_id">
                    <field name="currency_id" invisible="1"/>
                    <field name="annual_fee" class="flex-grow-1" widget="float"/>
                </div>
            </xpath>

            <!-- Right column (next to Address): DOB / Gender / School / Special -->
            <xpath expr="//field[@name='function']" position="after">
                <div invisible="contact_type != 'person'">
                    <div class="d-flex align-items-center gap-2">
                        <label for="date_of_birth" class="mb-0 text-nowrap"/>
                        <field name="date_of_birth" widget="date" options="{'numeric': true}" class="flex-grow-1"/>
                    </div>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <label for="gender" class="mb-0 text-nowrap"/>
                        <field name="gender" widget="radio" options="{'horizontal': true}" class="flex-grow-1"/>
                    </div>

                    <div class="mt-2" invisible="portal_contact_type not in ('student','parent')">
                        <label for="school_id" class="fw-bold"/>
                        <div class="d-flex align-items-center gap-2">
                            <field name="school_id"
                                   class="fs-3 flex-grow-1"
                                   domain="[('contact_type','=','school')]"
                                   options="{'no_create': False}"/>
                            <field name="school_avatar_128" widget="image"
                                   class="rounded"
                                   options="{'size': [200, 512], 'img_class': 'rounded object-fit-contain'}"
                                   nolabel="1"/>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mt-2 align-items-center">
                            <span class="d-inline-flex align-items-center gap-1">
                                <span class="text-muted" title="Engelli">
                                    <svg fill="#000000" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" 
	 width="28" height="28" viewBox="0 0 535.5 535.5" xml:space="preserve"
	>
