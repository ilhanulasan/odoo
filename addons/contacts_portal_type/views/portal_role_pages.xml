<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Same two-column layout as /my (main + user card): enable my_details and retitle for drivers. -->
    <template id="portal_layout_drivers_heading" inherit_id="portal.portal_layout" priority="20">
        <xpath expr="//div[@id='wrap']//div[contains(@class, 'wrapper') and contains(@class, 'col-12')]/h3[@class='my-3']" position="replace">
            <h3 class="my-3 text-primary" t-if="page_name == 'drivers'" t-out="portal_drivers_header"/>
            <h3 class="my-3 text-primary" t-if="page_name == 'users'" t-out="portal_role_page_title"/>
            <h3 class="my-3" t-if="page_name not in ('drivers', 'users')" t-out="request.env._('My account')"/>
        </xpath>
    </template>

    <template id="portal_page_role_driver" name="Driver portal">
        <t t-call="portal.portal_layout">
            <t t-set="my_details" t-value="True"/>
            <div class="o_portal_drivers_home pt-2">
                <div class="d-grid gap-3 d-md-flex">
                    <a href="#" class="btn btn-primary btn-lg px-4 py-3 flex-md-fill text-center">
                        <span t-out="portal_drivers_btn_start_tour"/>
                    </a>
                    <a href="#" class="btn btn-outline-primary btn-lg px-4 py-3 flex-md-fill text-center">
                        <span t-out="portal_drivers_btn_enroll_student"/>
                    </a>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_page_role_parents" name="Parents portal">
        <t t-call="portal.portal_layout">
            <t t-set="partner" t-value="request.env.user.partner_id"/>
            <div class="container py-4">
                <h1 class="h2 mb-3" t-out="portal_role_page_title"/>
                <div class="row">
                    <div class="col-md-4">
                        <div class="card mb-3">
                            <div class="card-body text-center">
                                <t t-if="partner.image_1920 or partner.image_128">
                                    <img t-att-src="'data:image/png;base64,%s' % ((partner.image_1920 or partner.image_128).decode('utf-8'))" class="img-fluid rounded-circle mb-2" style="width:120px;height:120px;object-fit:cover;"/>
                                </t>
                                <h3 class="h5 mb-1" t-out="partner.name"/>
                                <p class="mb-1"><span class="text-muted">Phone:</span> <t t-esc="partner.phone or ''"/></p>
                                <p class="mb-1"><span class="text-muted">Email:</span> <t t-esc="partner.email or ''"/></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="mb-4">
                            <h4>Address</h4>
                            <p t-if="partner.street or partner.city or partner.zip or partner.country_id">
                                <t t-esc="partner.street or ''"/><t t-if="partner.street2"> <t t-esc="partner.street2"/></t><br/>
                                <t t-esc="partner.city or ''"/> <t t-esc="partner.zip or ''"/><br/>
                                <t t-esc="partner.state_id and partner.state_id.name or ''"/> <t t-esc="partner.country_id and partner.country_id.name or ''"/>
                            </p>
                            <p t-if="not (partner.street or partner.city or partner.zip or partner.country_id)">No address set.</p>
                        </div>
                        <div>
                            <h4>Map</h4>
                            <t t-set="addr" t-value="('%s %s %s %s %s' % (partner.street or '', partner.street2 or '', partner.city or '', partner.zip or '', partner.country_id and partner.country_id.name or '')).strip()"/>
                            <!-- Leaflet map will geocode the address via Nominatim and zoom to street level -->
                            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
                            <div id="partner_map" class="mb-3" t-att-data-addr="addr" style="width:100%;height:400px;min-height:200px;position:relative;"></div>
                            <script>
                                (function(){
                                    var container = document.getElementById('partner_map');
                                    if (!container) { return; }
                                    var address = (container.getAttribute('data-addr') || '').trim();
                                    function loadScript(url, cb){ var s=document.createElement('script'); s.src=url; s.onload=cb; document.head.appendChild(s); }
                                    function showMessage(msg){
                                        var el = container.querySelector('.map-msg');
                                        if (!el){
                                            el = document.createElement('div');
                                            el.className = 'map-msg';
                                            el.style.position = 'absolute';
                                            el.style.left = '0';
                                            el.style.right = '0';
                                            el.style.top = '0';
                                            el.style.padding = '8px';
                                            el.style.background = 'rgba(255,255,255,0.9)';
                                            el.style.zIndex = 1000;
                                            el.style.textAlign = 'center';
                                            container.appendChild(el);
                                        }
                                        el.textContent = msg;
                                    }
                                    function initLeaflet(){
                                        try{
                                            var map = L.map(container).setView([0,0], 2);
                                            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                                maxZoom: 19,
                                                attribution: '\\u00A9 OpenStreetMap contributors'
                                            }).addTo(map);
                                            if (!address){
                                                showMessage('No address set for this contact.');
                                                return;
                                            }
                                            var q = encodeURIComponent(address);
                                            var nominatimUrl = 'https://nominatim.openstreetmap.org/search?format=json&amp;limit=1&amp;q=' + q;
                                            // debug
                                            console.debug('Nominatim URL:', nominatimUrl);
                                            fetch(nominatimUrl, { method: 'GET' })
                                                .then(function(r){ return r.json(); })
                                                .then(function(results){
                                                    if (results &amp;&amp; results.length){
                                                        var r0 = results[0];
                                                        var lat = parseFloat(r0.lat), lon = parseFloat(r0.lon);
                                                        map.setView([lat, lon], 17);
                                                        L.marker([lat, lon]).addTo(map);
                                                    } else {
                                                        showMessage('Address not found on map.');
                                                    }
                                                }).catch(function(err){
                                                    console.error('Geocode error', err);
                                                    showMessage('Error finding address.');
                                                });
                                        }catch(e){
                                            console.error(e);
                                            showMessage('Map initialization error.');
                                        }
                                    }
                                    if (typeof L === 'undefined'){
                                        loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js', initLeaflet);
                                    } else { initLeaflet(); }
                                })();
                            </script>
                        </div>
                    </div>
                </div>

                <!-- Students: render a responsive card grid with avatar, name, school, route and shuttle. -->
                <div class="container mt-4">
                    <h3>Students</h3>

                    <!-- Re-browse ids with sudo to ensure visibility through nested t-call templates. -->
                    <t t-set="student_ids" t-value="portal_parent_student_ids"/>
                    <t t-set="students" t-value="request.env['res.partner'].sudo().browse(student_ids)"/>

                    <t t-if="student_ids and students">
                        <div class="row">
                            <t t-foreach="students" t-as="child">
                                <div class="col-12 col-md-6 col-lg-4 mb-3">
                                    <div class="card h-100 shadow-sm">
                                        <div class="card-body text-center">
                                            <t t-if="child.image_1920 or child.image_128">
                                                <img t-att-src="'data:image/png;base64,%s' % ((child.image_1920 or child.image_128).decode('utf-8'))"
                                                     class="img-fluid rounded-circle mb-2"
                                                     style="width:120px;height:120px;object-fit:cover;"/>
                                            </t>
                                            <h5 class="h5 mb-1" t-out="child.name"/>
                                            <p class="mb-1 text-muted small">
                                                <t t-set="birth" t-value="('birth_date' in child._fields and child.birth_date) or ('birthday' in child._fields and child.birthday) or ('date_of_birth' in child._fields and child.date_of_birth)"/>
                                                <t t-if="birth"><t t-esc="birth"/></t>
                                            </p>
                                            <div class="mt-2 text-start">
                                                <t t-if="child.school_id">
                                                    <div class="mb-1">
                                                        <div class="text-muted small">School</div>
                                                        <div t-out="child.school_id.name"/>
                                                    </div>
                                                </t>
                                                <t t-if="child.route_id or ('route' in child._fields and child.route)">
                                                    <div class="mb-1">
                                                        <div class="text-muted small">Route</div>
                                                        <t t-if="child.route_id"><div t-out="child.route_id.name"/></t>
                                                        <t t-elif="'route' in child._fields and child.route"><div t-out="child.route"/></t>
                                                    </div>
                                                </t>
                                                <t t-set="shuttle" t-value="('shuttle_id' in child._fields and child.shuttle_id) or ('route_shuttle_id' in child._fields and child.route_shuttle_id) or ('shuttle' in child._fields and child.shuttle)"/>
                                                <t t-if="shuttle">
                                                    <div class="mb-1">
                                                        <div class="text-muted small">Shuttle</div>
                                                        <t t-if="'shuttle_id' in child._fields and child.shuttle_id"><div t-out="child.shuttle_id.name"/></t>
                                                        <t t-elif="'route_shuttle_id' in child._fields and child.route_shuttle_id"><div t-out="child.route_shuttle_id.name"/></t>
                                                        <t t-elif="'shuttle' in child._fields"><div t-out="child.shuttle"/></t>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-if="not student_ids">
                        <p>No students linked to this parent.</p>
                    </t>
                </div>
            </div>
        </t>
    </template>

