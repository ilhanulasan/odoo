    <template id="portal_page_role_hostess" name="Hostess portal">
        <t t-call="portal.portal_layout">
            <t t-set="my_details" t-value="True"/>
            <t t-set="partner" t-value="partner or request.env.user.partner_id"/>
            <div class="container py-4 o_portal_hostess_users" id="hostess_tour_portal_root">
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <t t-if="partner.image_1920 or partner.image_128">
                                    <img t-att-src="'data:image/png;base64,%s' % ((partner.image_1920 or partner.image_128).decode('utf-8'))"
                                         class="img-fluid rounded-circle mb-2"
                                         style="width:120px;height:120px;object-fit:cover;"
                                         alt=""/>
                                </t>
                                <h2 class="h5 mb-0" t-out="partner.name"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <h2 class="h4 mb-3" t-out="hostess_ui['page_heading']"/>
                        <p t-if="open_hostess_tour" class="text-muted small mb-2">
                            <span t-out="hostess_ui['active_tour_prefix']"/> <strong t-out="open_hostess_tour.tour_no"/>
                        </p>
                        <p t-if="not open_hostess_tour" class="text-muted small mb-2" t-out="hostess_ui['no_active_tour']"/>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label" t-out="hostess_ui['label_route']"/>
                                <select id="hostess_route_select" class="form-select" t-att-disabled="open_hostess_tour">
                                    <option value="" t-out="hostess_ui['select_route']"/>
                                    <t t-foreach="portal_routes" t-as="r">
                                        <option t-att-value="r.id" t-out="r.display_name"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" t-out="hostess_ui['label_shuttle']"/>
                                <select id="hostess_shuttle_select" class="form-select" t-att-disabled="open_hostess_tour">
                                    <option value="" t-out="hostess_ui['select_shuttle']"/>
                                    <t t-foreach="portal_shuttles" t-as="s">
                                        <option t-att-value="s.id" t-attf-data-route-id="{{ s.route_id.id if s.route_id else '' }}" t-out="s.display_name"/>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button type="button" id="hostess_btn_start" class="btn btn-primary" t-att-disabled="open_hostess_tour">
                                <t t-out="hostess_ui['btn_start']"/>
                            </button>
                            <button type="button" id="hostess_btn_add_point" class="btn btn-outline-primary" t-att-disabled="not open_hostess_tour">
                                <t t-out="hostess_ui['btn_add_point']"/>
                            </button>
                            <button type="button" id="hostess_btn_finish" class="btn btn-success" t-att-disabled="not open_hostess_tour">
                                <t t-out="hostess_ui['btn_finish']"/>
                            </button>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="hostess_notes_input" t-out="hostess_ui['label_notes']"/>
                            <textarea id="hostess_notes_input" class="form-control" rows="4" t-att-placeholder="hostess_ui['placeholder_notes']"
                                      t-att-readonly="not open_hostess_tour"><t t-esc="open_hostess_tour and (open_hostess_tour.notes or '') or ''"/></textarea>
                            <button type="button" id="hostess_btn_save_notes" class="btn btn-outline-secondary btn-sm mt-2" t-att-disabled="not open_hostess_tour">
                                <t t-out="hostess_ui['btn_save_notes']"/>
                            </button>
                        </div>

                        <div id="hostess_tour_status" class="alert alert-light border small d-none" role="status"/>
                    </div>
                </div>
                <script type="application/json" id="hostess_tour_bootstrap"><t t-out="hostess_tour_json"/></script>
            </div>
        </t>
    </template>

