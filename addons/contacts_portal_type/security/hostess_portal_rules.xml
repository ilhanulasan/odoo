<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_shuttle_tour_portal_hostess" model="ir.rule">
        <field name="name">Shuttle Tour: portal hostess own tours</field>
        <field name="model_id" ref="shuttle_management.model_shuttle_tour"/>
        <field name="domain_force">[('hostess_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_shuttle_tour_point_portal_hostess" model="ir.rule">
        <field name="name">Shuttle Tour Point: portal hostess own tour points</field>
        <field name="model_id" ref="shuttle_management.model_shuttle_tour_point"/>
        <field name="domain_force">[('tour_id.hostess_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
