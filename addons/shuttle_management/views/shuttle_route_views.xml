<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shuttle_route_tree" model="ir.ui.view">
        <field name="name">shuttle.route.list</field>
        <field name="model">shuttle.route</field>
        <field name="arch" type="xml">
            <list string="Routes">
                <field name="route_code"/>
                <field name="route_no"/>
                <field name="name"/>
                <field name="shuttle_id"/>
            </list>
        </field>
    </record>

    <record id="view_shuttle_route_form" model="ir.ui.view">
        <field name="name">shuttle.route.form</field>
        <field name="model">shuttle.route</field>
        <field name="arch" type="xml">
            <form string="Route">
                <sheet>
                    <group>
                        <group>
                            <field name="route_code"/>
                            <field name="route_no"/>
                            <field name="name"/>
                        </group>
                        <group string="Shuttle">
                            <field name="shuttle_id"/>
                            <field name="shuttle_plate_number" invisible="not shuttle_id"/>
                            <field name="shuttle_picture" widget="image" class="oe_avatar" invisible="not shuttle_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Route Points" name="points">
                            <field name="point_ids" nolabel="1">
                                <list string="Points" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="address" readonly="1"/>
                                    <field name="latitude" optional="hide"/>
                                    <field name="longitude" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tours" name="tours">
                            <field name="tour_ids" nolabel="1">
                                <list string="Tours" editable="bottom">
                                    <field name="tour_no"/>
                                    <field name="date"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="total_duration"/>
                                    <field name="shuttle_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <div class="mt-3 mb-2">
                        <span class="o_form_label">Map</span>
                        <widget name="shuttle_route_map"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shuttle_route_search" model="ir.ui.view">
        <field name="name">shuttle.route.search</field>
        <field name="model">shuttle.route</field>
        <field name="arch" type="xml">
            <search string="Routes">
                <field name="route_code"/>
                <field name="route_no"/>
                <field name="name"/>
                <field name="shuttle_id"/>
            </search>
        </field>
    </record>

    <record id="action_shuttle_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">shuttle.route</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shuttle_route_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a route and define its coordinates.
            </p>
        </field>
    </record>
</odoo>
