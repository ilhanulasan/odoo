<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shuttle_vehicle_brand_tree" model="ir.ui.view">
        <field name="name">shuttle.vehicle.brand.list</field>
        <field name="model">shuttle.vehicle.brand</field>
        <field name="arch" type="xml">
            <list string="Vehicle Brands" create="true" edit="true" delete="true">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="image" widget="image" options="{'size': [15, 15]}"/>
            </list>
        </field>
    </record>

    <record id="view_shuttle_vehicle_brand_form" model="ir.ui.view">
        <field name="name">shuttle.vehicle.brand.form</field>
        <field name="model">shuttle.vehicle.brand</field>
        <field name="arch" type="xml">
            <form string="Vehicle Brand" create="true" edit="true" delete="true">
                <sheet>
                    <group>
                        <group string="Brand">
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Logo">
                            <field name="image" widget="image" string="Logo image" class="oe_avatar"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shuttle_vehicle_brand" model="ir.actions.act_window">
        <field name="name">Vehicle Brands</field>
        <field name="res_model">shuttle.vehicle.brand</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="context">{'create': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a brand and upload its logo image.
            </p>
        </field>
    </record>
</odoo>
