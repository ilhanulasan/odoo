<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="index" name="Berkay Turizm - Homepage">
    <t t-call="website.layout">
      <t t-set="title">Berkay Turizm — Güvenle Taşıyoruz</t>

      <xpath expr="//head" position="inside">
        <link rel="stylesheet" type="text/css" href="/website_berkay/static/src/css/style.css"/>
      </xpath>

      <div class="berkay-hero">
        <div class="container berkay-hero-inner">
          <h1 class="berkay-title">Berkay <strong>TURİZM</strong></h1>
          <h2 class="berkay-subtitle">Güvenle Taşıyoruz</h2>
          <div class="berkay-cta">
            <a class="btn btn-primary" href="#services">Hizmetlerimiz</a>
            <a class="btn btn-outline" href="#contact">Hemen Ara</a>
          </div>
        </div>
      </div>

      <section id="services" class="section services">
        <div class="container">
          <h3 class="section-title">Hizmetlerimiz</h3>
          <div class="services-grid">
            <div class="service-card">
              <h4>Öğrenci Taşımacılığı</h4>
            </div>
            <div class="service-card">
              <h4>Personel Taşımacılığı</h4>
            </div>
            <div class="service-card">
              <h4>Havaalanı Transferi</h4>
            </div>
            <div class="service-card">
              <h4>VIP Transfer</h4>
            </div>
            <div class="service-card">
              <h4>Araç Filo Kiralama</h4>
            </div>
          </div>
        </div>
      </section>

      <section class="section about">
        <div class="container">
          <div class="about-grid">
            <div>
              <h3>Berkay Turizm ile Güvendesiniz</h3>
              <p>Güvenilir, konforlu ve dakik hizmet. Müşteri memnuniyeti odaklı servislerimizle çeşitli kurumlara servis sağlıyoruz.</p>
            </div>
            <div class="contact-box" id="contact">
              <h4>İletişim</h4>
              <p>Telefon: <a href="tel:+902167594550">0 216 759 45 50</a></p>
              <p>Whatsapp: <a href="https://wa.me/905435195251">0 543 519 52 51</a></p>
              <p>Email: <a href="mailto:info@berkayturizm.com">info@berkayturizm.com</a></p>
              <p>Website: <a href="https://www.berkayturizm.com" target="_blank">www.berkayturizm.com</a></p>
            </div>
          </div>
        </div>
      </section>

      <footer class="berkay-footer">
        <div class="container footer-inner">
          <div class="footer-left">
            <p>Copyright © 2020 - Berkay Turizm</p>
          </div>
          <div class="footer-right">
            <ul class="footer-links">
              <li><a href="#">Gizlilik Politikamız</a></li>
              <li><a href="#">İletişim</a></li>
            </ul>
          </div>
        </div>
      </footer>

    </t>
  </template>
</odoo>

